# .env (Contoh Konfigurasi Production)
# Silakan copy file ini menjadi ".env" di server Ubuntu Anda lalu ganti nilainya!

# --- Konfigurasi Database ---
POSTGRES_DB=miayam_prod
POSTGRES_USER=miayam_admin
POSTGRES_PASSWORD=ganti_dengan_password_db_yang_sangat_kuat

# --- Konfigurasi Keamanan API (Header) ---
# Gunakan kombinasi huruf/angka acak untuk keamanan maksimal di production!
API_KEY=API_KEY_PRODUCTION_RAHASIA_ANDA
API_SECRET=API_SIGNATURE_PRODUCTION_RAHASIA_ANDA
